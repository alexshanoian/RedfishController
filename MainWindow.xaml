
<Window x:Class="RedfishController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redfish Hardware Controller"
        Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="REDFISH CONTROLLER"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#52657A"/>
            <TextBlock Text="Hardware Explorer"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#172B4D"
                       Margin="0,4,0,0"/>
            <TextBlock Text="Explore and inspect your HPE iLO resources"
                       FontSize="14"
                       Foreground="#68778D"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Connection bar -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Endpoint"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="#344563"/>

                <TextBox x:Name="EndpointBox"
                         Grid.Column="1"
                         Text="https://localhost"
                         VerticalContentAlignment="Center"
                         Padding="8"
                         Margin="0,0,12,0"/>

                <Button Grid.Column="2"
                        Content="Connect"
                        Click="Connect_Click"
                        Padding="18,8"
                        Margin="0,0,8,0"
                        Background="#245DB2"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Grid.Column="3"
                        Content="Refresh"
                        Click="Refresh_Click"
                        Padding="18,8"/>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Resource navigation -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,18,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="RESOURCES"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#52657A"
                               Margin="0,0,0,12"/>

                    <TreeView x:Name="ResourceTree"
                              SelectedItemChanged="ResourceTree_SelectedItemChanged">
                        <TreeViewItem Header="Redfish Service">
                            <TreeViewItem Header="Systems"/>
                            <TreeViewItem Header="Chassis"/>
                            <TreeViewItem Header="Managers"/>
                            <TreeViewItem Header="Update Service"/>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Resource details -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle"
                                   Text="Not connected"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#172B4D"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="DetailSubtitle"
                                   Text="Connect to your Redfish emulator to begin"
                                   FontSize="13"
                                   Foreground="#68778D"
                                   Margin="0,6,0,20"
                                   TextWrapping="Wrap"/>

                        
<WrapPanel x:Name="SummaryCards"
           Margin="0,0,0,18"/>

<TextBlock Text="RESOURCE PROPERTIES"
           FontSize="12"
           FontWeight="Bold"
           Foreground="#52657A"
           Margin="0,0,0,8"/>

<TreeView x:Name="PropertyTree"
          MinHeight="180"
          MaxHeight="360"
          Margin="0,0,0,18"/>

<TextBlock Text="RAW JSON"
           FontSize="12"
           FontWeight="Bold"
           Foreground="#52657A"
           Margin="0,0,0,8"/>

<TextBox x:Name="RawJsonBox"
         IsReadOnly="True"
         AcceptsReturn="True"
         TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"
         HorizontalScrollBarVisibility="Auto"
         FontFamily="Consolas"
         FontSize="12"
         MinHeight="150"
         Padding="10"
         BorderThickness="1"
         BorderBrush="#D9E0EA"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

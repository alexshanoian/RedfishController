
<Window x:Class="RedfishController.Views.ApiResponseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redfish API Response"
        Width="850"
        Height="650"
        MinWidth="550"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="HTTP RESPONSE"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Margin="0,16,0,14">
            <TextBlock x:Name="StatusText"
                       FontSize="16"
                       FontWeight="Bold"/>

            <TextBlock x:Name="RequestText"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <TextBox x:Name="ResponseBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="14"
                 Background="#17202D"
                 Foreground="#E5EDF6"
                 BorderThickness="0"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">

            <Button Content="Copy Response"
                    Click="Copy_Click"
                    Padding="16,9"
                    Margin="0,0,8,0"/>

            <Button Content="Save JSON"
                    Click="Save_Click"
                    Padding="16,9"
                    Margin="0,0,8,0"/>

            <Button Content="Close"
                    Click="Close_Click"
                    Padding="16,9"/>
        </StackPanel>
    </Grid>
</Window>
